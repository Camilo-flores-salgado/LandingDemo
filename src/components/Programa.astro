---
interface Bloque {
	hora: string;
	titulo: string;
	lugar?: string;
	pausa?: boolean;
	cuposLimitados?: boolean;
}

const agenda: Bloque[] = [
	{ hora: '09:00', titulo: 'Acreditación y café', pausa: true },
	{ hora: '09:30', titulo: 'Apertura: el estado de las PyMEs del valle', lugar: 'Salón principal' },
	{ hora: '10:15', titulo: 'Vender más sin gastar más', lugar: 'Salón principal' },
	{ hora: '11:15', titulo: 'Café', pausa: true },
	{
		hora: '11:30',
		titulo: 'Tu negocio en internet: qué sirve y qué es humo',
		lugar: 'Salón principal',
	},
	{ hora: '13:00', titulo: 'Almuerzo libre', pausa: true },
	{
		hora: '14:30',
		titulo: 'Taller: ordena las finanzas de tu negocio',
		lugar: 'Sala taller',
		cuposLimitados: true,
	},
	{
		hora: '16:00',
		titulo: 'Panel: tres negocios del valle que crecieron',
		lugar: 'Salón principal',
	},
	{ hora: '17:00', titulo: 'Cierre y networking', lugar: 'Terraza' },
];
---

<section id="programa" class="w-full bg-espresso">
	<div class="mx-auto max-w-3xl px-6 py-16">
		<h2 class="font-display text-3xl font-black text-crema sm:text-4xl">El programa del día</h2>

		<p class="font-body mt-4 text-lg text-crema">
			Sábado 7 de noviembre <span class="text-ambar">·</span> Casona Aconcagua, San Felipe.
		</p>

		<ol class="mt-10">
			{
				agenda.map((bloque) => (
					<li class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-t border-crema/15 py-4 first:border-t-0">
						<time
							datetime={bloque.hora}
							class="font-display w-16 shrink-0 text-lg font-bold tabular-nums text-crema"
						>
							{bloque.hora}
						</time>

						<div class="min-w-0 flex-1">
							<p
								class={
									bloque.pausa
										? 'font-body font-medium text-[#A8977D]'
										: 'font-body font-semibold text-crema'
								}
							>
								{bloque.titulo}
								{bloque.cuposLimitados && (
									<span class="font-body ml-2 inline-block rounded-full border border-ambar px-2 py-0.5 text-xs font-semibold text-crema align-middle">
										Cupos limitados
									</span>
								)}
							</p>

							{bloque.lugar && <p class="font-body mt-0.5 text-sm text-[#A8977D]">{bloque.lugar}</p>}
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>
