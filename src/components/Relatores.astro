---
interface Relator {
	iniciales: string;
	nombre: string;
	cargo: string;
	bloque: string;
	color: 'ambar' | 'espresso' | 'terra';
}

const relatores: Relator[] = [
	{
		iniciales: 'MF',
		nombre: 'Marcela Fuentes',
		cargo: 'Asesora en ventas para pequeños negocios',
		bloque: 'Vender más sin gastar más',
		color: 'ambar',
	},
	{
		iniciales: 'RS',
		nombre: 'Rodrigo Salinas',
		cargo: 'Contador, especialista en finanzas para PyMEs',
		bloque: 'Taller: ordena las finanzas de tu negocio',
		color: 'espresso',
	},
	{
		iniciales: 'CO',
		nombre: 'Camila Ortiz',
		cargo: 'Consultora en presencia digital',
		bloque: 'Tu negocio en internet: qué sirve y qué es humo',
		color: 'terra',
	},
];

/*
 * Crema sobre ámbar (3.19:1) y sobre terra (4.37:1) no llega al 4.5:1 de AA
 * para texto normal, así que ahí las iniciales van en tinta (4.75:1 y 3.47:1
 * respectivamente). Sobre espresso, crema pasa 13.49:1 sin problema.
 */
const fondo: Record<Relator['color'], string> = {
	ambar: 'bg-ambar',
	espresso: 'bg-espresso',
	terra: 'bg-terra',
};
const textoIniciales: Record<Relator['color'], string> = {
	ambar: 'text-tinta',
	espresso: 'text-crema',
	terra: 'text-tinta',
};
---

<section id="relatores" class="w-full border-t border-linea bg-crema">
	<div class="mx-auto max-w-3xl px-6 py-16">
		<h2 class="font-display text-3xl font-black text-tinta sm:text-4xl">Quiénes exponen</h2>

		<p class="font-body mt-4 text-lg text-tinta-2">
			Tres personas que trabajan todos los días con negocios como el tuyo.
		</p>

		<div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-3 sm:gap-6">
			{
				relatores.map((relator) => (
					<div class="border-t border-linea pt-6">
						<div
							aria-hidden="true"
							class={`flex h-20 w-20 items-center justify-center rounded ${fondo[relator.color]}`}
						>
							<span class={`font-display text-2xl font-black ${textoIniciales[relator.color]}`}>
								{relator.iniciales}
							</span>
						</div>

						<h3 class="font-display mt-4 text-lg font-semibold text-tinta">{relator.nombre}</h3>
						<p class="font-body mt-1 text-sm text-tinta-2">{relator.cargo}</p>

						<div class="mt-4 border-t border-linea pt-3">
							<p class="font-body text-xs font-semibold text-terra">Expone:</p>
							<p class="font-body text-tinta">{relator.bloque}</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
